#include "fs_version.h"

101 ICON "app.ico"
// The same icon under the name the settings window (settings/src/pages.cpp, wxICON(aaaa)) asks for.
aaaa ICON "app.ico"

// Beginnings of words for the automatic switch in the middle of a word (WordStart.h; tools/corpus/make_wordlist.cmd;
// FrequencyWords by Hermit Dave, CC BY-SA 4.0 - see src/data/README.md).
WORDS_RU RCDATA "../data/words_ru.txt"
WORDS_EN RCDATA "../data/words_en.txt"
WORDS_RU_COMMON RCDATA "../data/words_ru_common.txt"
WORDS_EN_COMMON RCDATA "../data/words_en_common.txt"

// The name Task Manager and the file's properties show.
1 VERSIONINFO
FILEVERSION FS_VER_MAJOR, FS_VER_MINOR, FS_VER_PATCH, 0
PRODUCTVERSION FS_VER_MAJOR, FS_VER_MINOR, FS_VER_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FluentSwitcher"
            VALUE "FileVersion", FS_VERSION
            VALUE "InternalName", "FluentSwitcher"
            VALUE "LegalCopyright", "GPL-3.0. Based on SimpleSwitcher by Aegel5"
            VALUE "OriginalFilename", "FluentSwitcher.exe"
            VALUE "ProductName", "FluentSwitcher"
            VALUE "ProductVersion", FS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
