// The settings window of FluentSwitcher: its icon (the engine's), version, manifest.
aaaa ICON "app.ico"

1 VERSIONINFO
FILEVERSION 7, 0, 6, 0
PRODUCTVERSION 7, 0, 6, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FluentSwitcher settings"
            VALUE "FileVersion", "7.0.6"
            VALUE "InternalName", "FluentSwitcherSettings"
            VALUE "LegalCopyright", "GPL-3.0. Based on SimpleSwitcher by Aegel5"
            VALUE "OriginalFilename", "FluentSwitcherSettings.exe"
            VALUE "ProductName", "FluentSwitcher"
            VALUE "ProductVersion", "7.0.6"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "settings.manifest"
