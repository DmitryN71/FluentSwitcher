# Windows scripts keep Windows line ends whatever core.autocrlf is (cmd.exe misreads some LF-only scripts).
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# The word lists built into the exe (src/res/res.rc): bytes as they are - a CR at each word would break the search.
src/data/words_*.txt -text